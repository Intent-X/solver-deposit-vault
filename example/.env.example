# Private key of the wallet that holds SIGNER_ROLE on the vault.
# Default in code is the public Hardhat account #0 key — LOCAL TESTING ONLY.
SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed SolverVault proxy address (the EIP-712 verifyingContract).
VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Chain id the vault is deployed on (31337 = local Hardhat, 8453 = Base).
CHAIN_ID=31337

# Collateral token decimals (mock / USDC = 6).
COLLATERAL_DECIMALS=6

# Max amount in whole dollars (exclusive) the service will auto-sign.
MAX_WITHDRAWAL_USD=100

# HTTP port.
PORT=3000
